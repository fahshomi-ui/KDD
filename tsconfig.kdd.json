{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["client/src/*"] },
    "types": ["vite/client", "node"]
  },
  "include": [
    "client/src/kdd/**/*.ts",
    "client/src/kdd/**/*.tsx",
    "client/src/kdd-main.tsx",
    "vite.kdd.config.ts"
  ]
}
