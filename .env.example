# Copy this file to .env and fill in the values from your Supabase / Lovable project.
# The same two variables must also be set in the hosting provider (e.g. Vercel → Settings → Environment Variables).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
