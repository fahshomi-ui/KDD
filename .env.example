# Optional: override the default Supabase project (defaults are in src/integrations/supabase/client.ts).
# If set, configure the same variables in the hosting provider (e.g. Vercel → Settings → Environment Variables).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
